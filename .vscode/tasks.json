      },
      "inAgents": true
    },
    {
      "label": "Full Stack",
      "dependsOn": [
        "Backend",
        "Frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "inAgents": true
    }
  ]
}
